    [
     "right",
     "fish_special_marlin",
     "Uh... Hey! Feel like going for a swim around the neighborhood?",
     "fish_special_nemo"
    ],
    [
     "left",
     "fish_special_nemo",
     "Sure! And on the way, we can see what others are doing in their reefs!",
