  {
   "id": "d_rarefish",
   "lines": [
    [
     "left",
     "fish_special_nemo",
     "Dad, look, look! I have never seen such a beautiful fish in our reef before!",
     "fish_special_marlin"
    ],
    [
     "right",
     "fish_special_marlin",
     "This is the beauty of Rare Plants, Nemo.",
