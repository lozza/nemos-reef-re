 "dialogs": [
  {
   "id": "d_intro",
   "lines": [
    [
     "left",
     "fish_special_nemo",
     "Hey Dad, guess what we learned about in school today?! C'mon, guess! Guess!",
     "fish_special_marlin"
    ],
    [
     "right",
     "fish_special_marlin",
     "Well, I already know it wasn't patience...",
     "fish_special_nemo"
    ],
    [
     "left",
     "fish_special_nemo",
     "Huh? No! REEF BUILDING! It's soooo cool!",
     "fish_special_marlin"
    ],
    [
     "right",
     "fish_special_tad",
     "Hey Nemo, did you start your reef building project yet?",
     "fish_special_nemo"
    ],
    [
     "right",
     "fish_special_tad",
     "My Dad and I are going to build the coolest reef in class!",
     "fish_special_nemo"
    ],
    [
     "left",
     "fish_special_nemo",
     "Not if we build it first! Come on Dad, let's get building!",
     "fish_special_marlin"
    ],
    [
     "right",
     "fish_special_marlin",
     "Wait! What?! Oh, okay, I guess we're building a reef...",
     "fish_special_nemo"
    ],
    [
     "left",
     "fish_special_nemo",
     "Mr. Ray says that Algae and sunlight are the secret to growing reefs.",
     "fish_special_marlin"
    ],
    [
     "right",
     "fish_special_marlin",
     "Huh? Why Algae?",
     "fish_special_nemo"
    ],
    [
     "left",
     "fish_special_nemo",
     "Mr. Ray said that Coral and Algae work together to take advantage of sunlight. And Algae lives in coral.",
     "fish_special_marlin"
    ],
    [
     "right",
     "fish_special_marlin",
     "Well what are we waiting for? Let's find a coral and get our fins on some Algae!",
     "fish_special_nemo"
    ]
   ]
  },
  {
   "id": "d_seed",
   "lines": [
    [
     "left",
     "fish_special_nemo",
     "We have Algae. Now what?",
     "fish_special_marlin"
    ],
    [
     "right",
     "fish_special_marlin",
     "Well, ya know, even the biggest reefs start out tiny.",
     "fish_special_nemo"
    ],
    [
     "right",
     "fish_special_marlin",
     "Take a tiny cutting, and with care, it'll grow into a beautiful reef plant in no time.",
     "fish_special_nemo"
    ],
    [
     "left",
     "fish_special_nemo",
     "You got it!",
     "fish_special_marlin"
    ]
   ]
  },
  {
   "id": "d_food",
   "lines": [
    [
     "left",
     "fish_special_nemo",
     "Dad, our plant isn't growing!",
     "fish_special_marlin"
    ],
    [
     "right",
     "fish_special_marlin",
     "Plants need care to grow, just like you Nemo.",
     "fish_special_nemo"
    ],
    [
     "left",
     "fish_special_nemo",
     "Algae time!",
     "fish_special_marlin"
    ],
    [
     "right",
     "fish_special_marlin",
     "Yep, prepare to be amazed.",
     "fish_special_nemo"
    ]
   ]
  },
  {
   "id": "d_change",
   "lines": [
    [
     "left",
     "fish_special_nemo",
     "Hey Dad, does everything on the reef make good homes for fish?",
     "fish_special_marlin"
    ],
    [
     "right",
     "fish_special_marlin",
     "Not all, some plants and animals are good for just sprucing up the reef.",
     "fish_special_nemo"
    ],
    [
     "right",
     "fish_special_marlin",
     "Red Branches, for example. Beautiful plant!",
     "fish_special_nemo"
    ]
   ]
  },
  {
